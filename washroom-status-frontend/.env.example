# Supabase Dashboard > Project Settings > API / Connect
# Copy to .env.local; never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
# Required for Supabase sign-in/reviews; optional for public gateway restroom searches.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server-only override; defaults to NEXT_PUBLIC_SUPABASE_URL/functions/v1/gateway.
# Use the gateway base URL, without /places/bathrooms.
WASHROOM_GATEWAY_URL=
# Server-only; same dedicated random value (32+ characters) in Next.js and gateway.
GATEWAY_IP_SIGNING_SECRET=
# Database/service-role credentials belong only in Supabase Edge Function secrets.
